      {
        "name": "measures (2)",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ],
        "lineageTag": "4fa2e60c-6c71-4d64-b791-915542113781",
        "measures": [
          {
            "name": "total sale",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ],
            "expression": [
              "VAR ProductOrderIds = VALUES(products[order_id])",
              "VAR BaseSales = SUM(orders[total_amount])",
              "RETURN",
              "    IF(",
              "        ISFILTERED(products[brand]) || ISFILTERED(products[name]) || ISFILTERED(products[product_id]),",
              "        CALCULATE(SUM(orders[total_amount]), TREATAS(ProductOrderIds, orders[order_id])),",
              "        BaseSales",
              "    )"
            ],
            "formatString": "$#,0;($#,0);$#,0",
            "lineageTag": "7f52618d-0aa8-4a99-b39b-5379df95c944"
          },
          {
            "name": "Total Quantity Sold",
            "expression": "COUNTROWS(products)",
            "formatString": "0",
            "lineageTag": "133e489a-10bc-45c7-9302-1365f4c9be2c"
          },
          {
            "name": "Number of Orders",
            "expression": "DISTINCTCOUNT(orders[order_id])",
            "formatString": "0",
            "lineageTag": "753a6eb9-07e7-42fc-94e0-da6cae923f26"
          },
          {
            "name": "Refund count",
            "expression": "DISTINCTCOUNT(refunds[order_id])",
            "formatString": "0",
            "lineageTag": "c18567c1-e654-4a80-8a7e-a3549fb86fd0"
          },
          {
            "name": "Order count",
            "expression": "DISTINCTCOUNT(orders[order_id])",
            "formatString": "0",
            "lineageTag": "35de5495-58d0-4cc6-b7bd-4ca7527f3501"
          },
          {
            "name": "Refund Rate",
            "expression": [
              "",
              "DIVIDE(",
              "    DISTINCTCOUNT(refunds[order_id]),",
              "    DISTINCTCOUNT(orders[order_id]),",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "b6b8455c-b1b4-4c05-81a2-c2af3c968162"
          },
          {
            "name": "Total refund",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ],
            "expression": "SUM(refunds[refund_amount])",
            "formatString": "$#,0;($#,0);$#,0",
            "lineageTag": "027df118-31c8-4f6c-ba6b-d379ba8c1239"
          },
          {
            "name": "Customers count",
            "expression": "COUNTROWS(customers)",
            "formatString": "0",
            "lineageTag": "6ca1dd32-e04f-4095-a784-1611503b837f"
          },
          {
            "name": "Average Price by Brand",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ],
            "expression": "AVERAGE(Products[price])",
            "formatString": "$#,0.00;($#,0.00);$#,0.00",
            "lineageTag": "1ea14112-22dd-447b-8c50-3194a397c3a1"
          },
          {
            "name": "Average oder value",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ],
            "expression": [
              "",
              "DIVIDE(",
              "    [total sale], [Order count], 0",
              ")"
            ],
            "formatString": "$#,0.00;($#,0.00);$#,0.00",
            "lineageTag": "9998274d-df12-40b4-b45b-a827c84713ee"
          },
          {
            "name": "Total Stock Quantity",
            "expression": "SUM(products[stock_quatity])",
            "formatString": "0",
            "lineageTag": "c06da399-51a6-49f3-a035-e481091a911e"
          }
        ],
        "partitions": [
          {
            "name": "measures (2)",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),",
                "    #\"Removed Columns\" = Table.RemoveColumns(Source,{\"Column1\"})",
                "in",
                "    #\"Removed Columns\""
              ],
              "type": "m"
            }
          }
        ]
      }
