      {
        "name": "measures (2)",
        "description": "Executive report measures.",
        "lineageTag": "34ca8452-f4ce-4eb4-a8ed-b766ea2fcdc2",
        "columns": [
          {
            "name": "_placeholder",
            "dataType": "double",
            "sourceColumn": "_placeholder",
            "summarizeBy": "sum",
            "lineageTag": "0c7a0ba5-279a-42f9-859f-ebe5c4d240d3",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "measures (2)",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRecords(Json.Document(Binary.Decompress(Binary.FromText(\"i65Wii/ISUxOzcjPSUktUrIyrI0FAA==\", BinaryEncoding.Base64), Compression.Deflate))),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"_placeholder\", type number}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Order Value USD",
            "expression": [
              "SUM(products[allocated_order_value_usd])"
            ],
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "description": "Order totals converted at the dated FX snapshot, allocated to lines by relative line price. Additive across brands; not recognized revenue or historical FX.",
            "lineageTag": "6b66a939-828d-4c32-9d10-51a09afdefaa"
          },
          {
            "name": "Orders",
            "expression": [
              "DISTINCTCOUNT(products[order_id])"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "74e96c21-d61c-4b53-b2fd-b09c280260e8"
          },
          {
            "name": "Order Lines",
            "expression": [
              "COUNTROWS(products)"
            ],
            "formatString": "#,0",
            "description": "Count of source product rows, not units sold.",
            "lineageTag": "6e05c901-3f95-4d45-96d6-ee4878f8d2b0"
          },
          {
            "name": "Average Order Value USD",
            "expression": [
              "DIVIDE([Order Value USD], [Orders])"
            ],
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "description": "Allocated order value divided by distinct orders in the same filter context.",
            "lineageTag": "b6b497af-d386-4d68-96c9-d73d69529a07"
          },
          {
            "name": "Purchasing Customers",
            "expression": [
              "VAR ids = VALUES(products[order_id]) RETURN CALCULATE(DISTINCTCOUNT(orders[customer_id]), KEEPFILTERS(TREATAS(ids, orders[order_id])))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "59403f97-7f85-451c-966f-e7bd812c8c6a"
          },
          {
            "name": "Repeat Buyers",
            "expression": [
              "VAR ids = VALUES(products[order_id])",
              "VAR t = CALCULATETABLE(SUMMARIZE(orders, orders[customer_id], \"n\", COUNTROWS(orders)), KEEPFILTERS(TREATAS(ids, orders[order_id])))",
              "RETURN COUNTROWS(FILTER(t, [n] > 1))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "38d2e2e6-5bd8-42ed-ba7f-d64e1b276ffd"
          },
          {
            "name": "One-time Buyers",
            "expression": [
              "[Purchasing Customers] - [Repeat Buyers]"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "8d4651c8-34f4-438e-9191-3e893c352531"
          },
          {
            "name": "Repeat Buyer Rate",
            "expression": [
              "DIVIDE([Repeat Buyers], [Purchasing Customers])"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "description": "Share of purchasing customers with more than one selected order; not a cohort retention rate.",
            "lineageTag": "8862049d-a687-4257-aa5b-a7f47fd0254c"
          },
          {
            "name": "Segment Customers",
            "expression": [
              "SWITCH(SELECTEDVALUE(Segments[Segment]), \"One-time buyers\", [One-time Buyers], \"Repeat buyers\", [Repeat Buyers])"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "ece2ecf6-2247-4dab-b23b-b4854adc1abe"
          },
          {
            "name": "Customer Records",
            "expression": [
              "COUNTROWS(customers)"
            ],
            "formatString": "#,0",
            "description": "Customer master records; independent of order date, brand and order currency.",
            "lineageTag": "31155867-3b26-4918-8102-8c4b7032c4ee"
          },
          {
            "name": "Customer Rank",
            "expression": [
              "IF(NOT ISBLANK([Order Value USD]), RANKX(ALLSELECTED(customers[name]), [Order Value USD], , DESC, Dense))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "74b24fd3-e376-4ec2-8eb4-5b754fdbf0e9"
          },
          {
            "name": "Brand Rank",
            "expression": [
              "IF(NOT ISBLANK([Order Value USD]), RANKX(ALLSELECTED(products[brand]), [Order Value USD], , DESC, Dense))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "618d892d-9fac-47ad-af98-67c46bbffbcf"
          },
          {
            "name": "Country Share",
            "expression": [
              "DIVIDE([Order Value USD], CALCULATE([Order Value USD], ALLSELECTED(customers[country])))"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "description": "",
            "lineageTag": "650686ca-1b41-4011-831c-997dc14fea28"
          },
          {
            "name": "Refund Requests",
            "expression": [
              "VAR ids=VALUES(products[order_id]) RETURN CALCULATE(DISTINCTCOUNT(refunds[order_id]), KEEPFILTERS(TREATAS(ids, refunds[order_id])))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "6d2c139f-b6cf-4c54-ab9f-36572b27220c"
          },
          {
            "name": "Processed Requests",
            "expression": [
              "CALCULATE([Refund Requests], KEEPFILTERS(refunds[refund_status]=\"Processed\"))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "83f9d786-5276-4ce3-8807-b745cdcd127c"
          },
          {
            "name": "Pending Requests",
            "expression": [
              "CALCULATE([Refund Requests], KEEPFILTERS(refunds[refund_status]=\"Pending\"))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "17520c58-6912-49fd-a61c-37c60c10d53a"
          },
          {
            "name": "Rejected Requests",
            "expression": [
              "CALCULATE([Refund Requests], KEEPFILTERS(refunds[refund_status]=\"Rejected\"))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "f9ec39a6-e501-49e2-a7b6-ef7f9978a6be"
          },
          {
            "name": "Refund Request Rate",
            "expression": [
              "DIVIDE([Refund Requests],[Orders])"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "description": "Distinct selected orders with any refund request / selected orders. Includes processed, pending and rejected requests.",
            "lineageTag": "50794fed-0419-489d-8763-8115ab860faf"
          },
          {
            "name": "Processed Refund Rate",
            "expression": [
              "DIVIDE([Processed Requests],[Orders])"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "description": "",
            "lineageTag": "efa69744-a70f-4869-90fc-13bc85460222"
          },
          {
            "name": "Requested Refund USD",
            "expression": [
              "VAR ids=VALUES(products[order_id]) RETURN CALCULATE(SUM(refunds[refund_amount_usd]), KEEPFILTERS(TREATAS(ids, refunds[order_id])))"
            ],
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "description": "Order-level requested amount at current FX, including all statuses. Not attributed to a returned product.",
            "lineageTag": "980e2e28-a1bd-4efe-819e-11bfd5521342"
          },
          {
            "name": "Processed Refund USD",
            "expression": [
              "CALCULATE([Requested Refund USD], KEEPFILTERS(refunds[refund_status]=\"Processed\"))"
            ],
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "description": "",
            "lineageTag": "92326e75-a3d5-460d-a690-37df2bd3119f"
          },
          {
            "name": "Pending Refund USD",
            "expression": [
              "CALCULATE([Requested Refund USD], KEEPFILTERS(refunds[refund_status]=\"Pending\"))"
            ],
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "description": "",
            "lineageTag": "19445037-ac54-4dac-a739-b967c3fa7f98"
          },
          {
            "name": "Prior Month Value USD",
            "expression": [
              "VAR hasCurrent=NOT ISBLANK([Order Value USD])",
              "VAR _priorValue=CALCULATE([Order Value USD], DATEADD('Calendar'[Date], -1, MONTH))",
              "RETURN IF(hasCurrent, _priorValue)"
            ],
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "description": "",
            "lineageTag": "0a853dee-713d-4eea-85f9-6d810be8da42"
          },
          {
            "name": "Monthly Change",
            "expression": [
              "DIVIDE([Order Value USD]-[Prior Month Value USD], [Prior Month Value USD])"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "description": "",
            "lineageTag": "40d93543-758d-413b-abc5-0a85592cc6d9"
          },
          {
            "name": "Latest Month Value USD",
            "expression": [
              "VAR _endDate=MAX('Calendar'[Date])",
              "VAR _startDate=DATE(YEAR(_endDate),MONTH(_endDate),1)",
              "RETURN CALCULATE([Order Value USD], REMOVEFILTERS('Calendar'), DATESBETWEEN('Calendar'[Date],_startDate,_endDate))"
            ],
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "description": "",
            "lineageTag": "7d1bc4e9-8705-4da0-bb6c-75f5ee6f5904"
          },
          {
            "name": "Latest Prior Month Value USD",
            "expression": [
              "VAR _endDate=EOMONTH(MAX('Calendar'[Date]),-1)",
              "VAR _startDate=DATE(YEAR(_endDate),MONTH(_endDate),1)",
              "RETURN CALCULATE([Order Value USD], REMOVEFILTERS('Calendar'), DATESBETWEEN('Calendar'[Date],_startDate,_endDate))"
            ],
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "description": "",
            "lineageTag": "67c92540-1665-42ec-b32d-c5401d348f96"
          },
          {
            "name": "Latest Month Change",
            "expression": [
              "DIVIDE([Latest Month Value USD]-[Latest Prior Month Value USD], [Latest Prior Month Value USD])"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "description": "",
            "lineageTag": "43317449-1add-4afb-b576-8a2b32959683"
          },
          {
            "name": "Delivered Orders",
            "expression": [
              "CALCULATE([Orders], KEEPFILTERS(orders[order_status]=\"Delivered\"))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "1ad7125c-729d-4f46-b290-3aeb5e1bf99f"
          },
          {
            "name": "Shipped Orders",
            "expression": [
              "CALCULATE([Orders], KEEPFILTERS(orders[order_status]=\"Shipped\"))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "d303c702-894e-41fe-b2e1-488c636bdcf4"
          },
          {
            "name": "Processing Orders",
            "expression": [
              "CALCULATE([Orders], KEEPFILTERS(orders[order_status]=\"Processing\"))"
            ],
            "formatString": "#,0",
            "description": "",
            "lineageTag": "65d3dfdb-9541-4421-a2d9-d1a367a72c20"
          },
          {
            "name": "Average Product Price USD",
            "expression": [
              "AVERAGE(products[price_usd])"
            ],
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "description": "Assumes line prices are expressed in their order currency.",
            "lineageTag": "a6dd9d1e-9fd6-499d-855c-07e20c0469f3"
          },
          {
            "name": "Source Stock",
            "expression": [
              "MAX(products[stock_quatity])"
            ],
            "formatString": "#,0",
            "description": "Source stock value shown only at product-row level. Snapshot date and inventory grain are unverified; do not sum across order lines.",
            "lineageTag": "20fe0f48-23b8-4435-86c7-0f28ba9e39ba"
          },
          {
            "name": "Sales Takeaway",
            "expression": [
              "VAR v=[Order Value USD]",
              "VAR brandTable=TOPN(1, ADDCOLUMNS(ALLSELECTED(products[brand]), \"v\", [Order Value USD]), [v], DESC, products[brand], ASC)",
              "VAR leader=CONCATENATEX(brandTable,products[brand],\", \")",
              "RETURN IF(ISBLANK(v), \"No orders match the current filters.\", \"Leading brand: \" & leader & \". Review its allocated contribution and monthly pattern before changing assortment.\")"
            ],
            "formatString": "General",
            "description": "",
            "lineageTag": "e1b0151e-c07e-4a9b-91a7-8803ddd1e739"
          },
          {
            "name": "Geo Takeaway",
            "expression": [
              "VAR t=TOPN(1, ADDCOLUMNS(ALLSELECTED(customers[country]), \"v\", [Order Value USD]), [v], DESC, customers[country], ASC)",
              "VAR country=CONCATENATEX(t,customers[country],\", \")",
              "VAR share=DIVIDE(SUMX(t,[v]),CALCULATE([Order Value USD],ALLSELECTED(customers[country])))",
              "RETURN IF(ISBLANK([Order Value USD]),\"No orders match the current filters.\",country & \" leads with \" & FORMAT(share,\"0.0%\") & \" of selected order value. Review market concentration and the smaller markets.\")"
            ],
            "formatString": "General",
            "description": "",
            "lineageTag": "64b9c1e9-15f0-4d84-a75e-cb30c4e97347"
          },
          {
            "name": "Customer Takeaway",
            "expression": [
              "IF(ISBLANK([Orders]), \"No purchasing customers match the current filters.\", FORMAT([Repeat Buyers],\"#,0\") & \" of \" & FORMAT([Purchasing Customers],\"#,0\") & \" buyers placed more than one selected order (\" & FORMAT([Repeat Buyer Rate],\"0.0%\") & \"). Investigate repeat purchase opportunities; this is not a retention metric.\")"
            ],
            "formatString": "General",
            "description": "",
            "lineageTag": "90163446-e53e-4d39-b84b-32ee5be55cec"
          },
          {
            "name": "Refund Takeaway",
            "expression": [
              "FORMAT(COALESCE([Refund Requests],0),\"0\") & \" requests: \" & FORMAT(COALESCE([Processed Requests],0),\"0\") & \" processed, \" & FORMAT(COALESCE([Pending Requests],0),\"0\") & \" pending, \" & FORMAT(COALESCE([Rejected Requests],0),\"0\") & \" rejected. Investigate pending cases and the leading request reasons.\""
            ],
            "formatString": "General",
            "description": "",
            "lineageTag": "680278b8-5182-42d1-ae86-f5650d5b0113"
          },
          {
            "name": "Trend Takeaway",
            "expression": [
              "VAR prior=[Latest Prior Month Value USD]",
              "VAR thisMonth=FORMAT(MAX('Calendar'[Date]),\"MMM yyyy\")",
              "RETURN IF(ISBLANK(prior)||prior=0,\"No comparable prior month is available for \" & thisMonth & \".\",thisMonth & \" order value is \" & FORMAT([Latest Month Change],\"+0.0%;-0.0%;0.0%\") & \" versus the preceding month at the same FX snapshot. Investigate the underlying order mix.\")"
            ],
            "formatString": "General",
            "description": "",
            "lineageTag": "08cc5b0c-1e0c-48e1-8ba2-027b8b865c2f"
          },
          {
            "name": "Selection Context",
            "expression": [
              "\"Order period: \" & FORMAT(MIN('Calendar'[Date]),\"dd MMM yyyy\") & \" to \" & FORMAT(MAX('Calendar'[Date]),\"dd MMM yyyy\") & \" | USD at 22 Sep 2026 Chicago FX snapshot\""
            ],
            "formatString": "General",
            "description": "",
            "lineageTag": "4f3945c6-9b61-4f58-9fce-fa2784b4a08d"
          }
        ]
      }
    ],
    "relationships": [
