        "partitions": [
          {
            "name": "customers",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = MySQL.Database(\"localhost:3306\", \"company\", [ReturnSingleDatabase=true]),",
                "    company_customers = Source{[Schema=\"company\",Item=\"customers\"]}[Data],",
                "    #\"Removed Columns\" = Table.RemoveColumns(company_customers,{\"company.orders\", \"company.refunds\"}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Removed Columns\",{{\"id\", Int64.Type}, {\"name\", type text}, {\"country\", type text}, {\"city\", type text}, {\"phone_number\", type text}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
