            ],
            "dataType": "string",
            "expression": [
              "",
              "    SWITCH(",
              "        TRUE(),",
              "        COUNTROWS(RELATEDTABLE(orders)) = 0, \"No Purchases\",",
              "        COUNTROWS(RELATEDTABLE(orders)) = 1, \"One-Time Buyer\",",
              "        \"Repeat Buyer\"",
              "    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "cb14405e-4f31-4cd8-a473-82a7c2977e18",
